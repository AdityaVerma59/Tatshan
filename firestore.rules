rules_version = '2';

// Layout:  boxes/{boxId}                  -> an inbox ("temp", 6 h) or a print shop ("shop", permanent)
//          boxes/{boxId}/transfers/{id}   -> one message: sender name + list of files
//          boxes/{boxId}/parts/{id}       -> ~700 KB pieces of the files themselves
//
// Anyone signed in (anonymous is enough) may SEND into a box if they know its code.
// Only the box's owner may read. The owner deletes everything once it's downloaded.
service cloud.firestore {
  match /databases/{database}/documents {

    match /boxes/{boxId} {
      allow get: if request.auth != null;
      allow list: if false;                       // codes can't be enumerated

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind in ['temp', 'shop']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && (request.resource.data.kind == 'shop'
            || (request.resource.data.expireAt is timestamp
                && request.resource.data.expireAt <= request.time + duration.value(6, 'h') + duration.value(2, 'm')));
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if false;

      match /transfers/{tid} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/boxes/$(boxId)).data.ownerUid == request.auth.uid
              || resource.data.senderUid == request.auth.uid);

        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/boxes/$(boxId))
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0 && request.resource.data.senderName.size() <= 40
          && request.resource.data.files is list
          && request.resource.data.files.size() > 0 && request.resource.data.files.size() <= 10
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'files', 'createdAt', 'expireAt']);

        allow delete: if request.auth != null
          && (get(/databases/$(database)/documents/boxes/$(boxId)).data.ownerUid == request.auth.uid
              || resource.data.senderUid == request.auth.uid);
        allow update: if false;
      }

      // File pieces. Only the owner can read them (one at a time, by exact id), only
      // within 6 hours of upload, so an unpicked file becomes unreadable on its own.
      match /parts/{partId} {
        allow get: if request.auth != null
          && get(/databases/$(database)/documents/boxes/$(boxId)).data.ownerUid == request.auth.uid
          && resource.data.createdAt > request.time - duration.value(6, 'h');
        allow list: if false;

        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/boxes/$(boxId))
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 760000
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['tid', 'senderUid', 'data', 'createdAt', 'expireAt']);

        allow delete: if request.auth != null
          && (get(/databases/$(database)/documents/boxes/$(boxId)).data.ownerUid == request.auth.uid
              || resource.data.senderUid == request.auth.uid);
        allow update: if false;
      }
    }
  }
}
